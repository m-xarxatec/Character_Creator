# Godot
.godot/

# Blender
*.blend1
__pycache__/

# Descargas y temporales
*.zip
*.tmp

# Capturas de prueba (se regeneran con los scripts), salvo las aprobadas y el historial
pruebas/**/capturas/*
!pruebas/capturas/aprobadas/
!pruebas/capturas/revision/
pruebas/capturas/revision/*
!pruebas/capturas/revision/HISTORIAL.md

# Referencias con derechos de autor (solo en local)
diseno/referencias/privadas/

# Referencias: solo lo que ya está en git (referencias/cuerpos/); nada nuevo, y nunca un .blend
referencias/*
!referencias/cuerpos/
referencias/cuerpos/*.blend

# Personajes generados por las pruebas
pruebas/**/salida/
pruebas/godot/personaje.glb*
pruebas/godot/bonemap_personaje.tres
